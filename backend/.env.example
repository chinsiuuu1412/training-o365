# Copy locally. Never commit actual credentials.
HTTP_ADDR=127.0.0.1:8080
# Approved-v2 requires a new database path. Legacy files are rejected, never upgraded.
DB_PATH=data/lms.db
SITE_ORIGIN=https://lms.example.edu.vn
JWT_SECRET=<replace-with-at-least-32-random-bytes>
SESSION_TTL_SECONDS=28800
# Empty trusts no forwarded headers. Proxy must overwrite X-Forwarded-For.
TRUSTED_PROXY_CIDRS=
# Empty DB bootstrap only. Remove after first successful bootstrap.
ADMIN_INITIAL_EMAIL=admin@example.edu.vn
ADMIN_INITIAL_PASSWORD=<replace-with-12-to-72-byte-password>
# Pristine synthetic seed only. Never use production credentials.
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_STUDENT_PASSWORD=